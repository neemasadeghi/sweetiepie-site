                    ]
                  }
                ],
                "description": "Optional — link to an article, review, etc.",
                "name": "link",
                "type": "url",
                "title": "Link URL"
              }
            ],
            "type": "object"
          }
        ],
        "name": "gallery",
        "type": "array",
        "title": "Gallery Stills"
      },
