  {
    "fields": [
      {
        "readOnly": true,
        "hidden": true,
        "name": "orderRank",
        "type": "string"
      },
      {
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ]
          }
        ],
        "description": "Artist name for music videos, or brand/client name for commercials",
        "name": "client",
        "type": "string",
        "title": "Artist / Client"
      },
      {
        "description": "Song title for music videos, or product/campaign name for commercials",
        "name": "subtitle",
        "type": "string",
        "title": "Song / Campaign Title"
      },
      {
        "options": {
          "list": [
            {
              "title": "Short Film",
              "value": "Short Film"
            },
            {
              "title": "Feature Film",
              "value": "Feature Film"
            },
            {
              "title": "Documentary",
              "value": "Documentary"
            }
          ]
        },
        "description": "Type of narrative project",
        "name": "format",
        "type": "string"
      },
      {
        "options": {
          "source": "client",
          "maxLength": 96
        },
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "custom"
              },
              {
                "flag": "presence",
                "constraint": "required"
              }
            ]
          }
        ],
        "name": "slug",
        "type": "slug"
      },
      {
        "options": {
          "list": [
            {
              "title": "Selected",
              "value": "selected"
            },
            {
              "title": "Music Video",
              "value": "music-video"
            },
            {
              "title": "Commercial",
              "value": "commercial"
            },
            {
              "title": "Documentary",
              "value": "narrative"
            }
          ]
        },
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "valid",
                "constraint": [
                  "selected",
                  "music-video",
                  "commercial",
                  "narrative"
                ]
              },
              {
                "flag": "presence",
                "constraint": "required"
              },
              {
                "flag": "min",
                "constraint": 1
              }
            ]
          }
        ],
        "of": [
          {
            "type": "string"
          }
        ],
        "name": "category",
        "type": "array",
        "title": "Categories"
      },
      {
        "options": {
          "hotspot": true
        },
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ]
          }
        ],
        "name": "still",
        "type": "image",
        "title": "Still Image"
      },
      {
        "description": "Recommended: short looping clip via Mux. Configure the Mux token in Studio (Videos / plugin setup) the first time you upload.",
        "name": "previewMux",
        "type": "mux.video",
        "title": "Preview video (Mux)"
      },
      {
        "options": {
          "accept": "video/mp4,video/webm"
        },
        "description": "Optional fallback: MP4/WebM hosted on Sanity. Prefer “Preview video (Mux)” for new work.",
        "name": "previewVideo",
        "type": "file",
        "title": "Preview video (legacy file)"
      },
      {
        "description": "Title displayed above the main video (e.g. \"A+ Smoothness\")",
        "name": "vimeoTitle",
        "type": "string",
        "title": "Primary Video Title"
      },
      {
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "uri",
                "constraint": {
                  "options": {
                    "scheme": [
                      "/^http$/",
                      "/^https$/"
                    ],
                    "allowRelative": false,
                    "relativeOnly": false,
                    "allowCredentials": false
                  }
                }
              }
            ]
          }
        ],
        "description": "Main Vimeo link — used as the hero video on the project page",
        "name": "vimeoUrl",
        "type": "url",
        "title": "Vimeo URL (Primary)"
      },
      {
        "description": "Add more Vimeo links to show below the main video",
        "of": [
          {
            "fields": [
              {
                "name": "title",
                "type": "string"
              },
              {
                "validation": [
                  {
                    "level": "error",
                    "rules": [
                      {
                        "flag": "uri",
                        "constraint": {
                          "options": {
                            "scheme": [
                              "/^http$/",
                              "/^https$/"
                            ],
                            "allowRelative": false,
                            "relativeOnly": false,
                            "allowCredentials": false
                          }
                        }
                      },
                      {
                        "flag": "presence",
                        "constraint": "required"
                      }
                    ]
                  }
                ],
                "name": "url",
                "type": "url",
                "title": "Vimeo URL"
              }
            ],
            "type": "object"
          }
        ],
        "name": "additionalVideos",
        "type": "array"
      },
      {
        "description": "Add stills to the project page. Each can have an optional caption and link.",
        "of": [
          {
            "fields": [
              {
                "options": {
                  "hotspot": true
                },
                "validation": [
                  {
                    "level": "error",
